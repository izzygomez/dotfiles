{
  "editor.minimap.enabled": false,
  "telemetry.telemetryLevel": "off",
  "git.autofetch": false,
  "search.followSymlinks": false,
  "window.title": "${rootPath}${separator}${activeEditorMedium}",
  "security.workspace.trust.enabled": false,
  "workbench.quickOpen.closeOnFocusLost": false,
  "crashReporting.enabled": "off",
  "workbench.enableExperiments": false,
  "npm.fetchOnlinePackageInfo": false,
  "files.exclude": {
    "**/.git": false
  },
  "redhat.telemetry.enabled": false,
  "editor.rulers": [
    80
  ],
  "editor.stickyScroll.enabled": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "files.associations": {
    "*.xml": "html",
    "*.svg": "html"
  },
  "editor.inlineSuggest.enabled": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnType": true
  },
  // turn off code suggestions in text files
  // got from: https://stackoverflow.com/a/71056461
  "[plaintext]": {
    "editor.quickSuggestions": {
      "other": false,
      "comments": false,
      "strings": false
    }
  },
  // Use built-in formatter for JSONC instead of Prettier.
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.wordWrap": "on",
  "gitlens.ai.experimental.generateCommitMessage.enabled": false,
  "gitlens.ai.enabled": false,
  "gitlens.telemetry.enabled": false,
  "inlineChat.lineNaturalLanguageHint": false,
  "explorer.confirmDragAndDrop": false,
  "cursor.cpp.disabledLanguages": [
    "plaintext",
    "scminput"
  ],
  "yaml.maxItemsComputed": 100000,
  "explorer.confirmDelete": false,
  "workbench.colorTheme": "Default Dark Modern",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "workbench.editor.enablePreview": false
}
